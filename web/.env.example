# Optional: set a different M3U playlist URL on the server.
# The default is https://iptv-org.github.io/iptv/index.m3u
IPTV_PLAYLIST_URL=https://iptv-org.github.io/iptv/index.m3u

# Optional: merge a second M3U playlist into the channel catalogue.
# Host your authorized playlist at an HTTPS URL and set it here.
IPTV_EXTRA_PLAYLIST_URL=

# Google OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
